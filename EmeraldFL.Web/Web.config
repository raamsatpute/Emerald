  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <add key="CacheLengthInSeconds" value="900" />
    <add key="GridPageSize" value="50"></add>
    <add key="GridMaxPageLimit" value="10"></add>
    <add key="EnDeKEY" value="xbC3mALXw9SnYJuzfH5P7B2aUMrQg8Tj" />
    <add key="EOU" value="eop" />
    <add key="EOP" value="c37e9efa213fb04f08b686ba1cea5a9e" />
    
    <add key="WEBURL" value="Staging" />
    <add key="SITECAPTION" value="Staging Site" />
    <add key="GeneralPath" value="C:\ExceptionDetailsFile" />




  </appSettings>
  <log4net debug="true">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="logs\log.txt" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
